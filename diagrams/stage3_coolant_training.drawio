        <mxCell id="17" value="&lt;b&gt;optim_similarity + optim_clip&lt;/b&gt;  (Adam, lr=1e-4, wd=1e-5)&#xa;Warmup-cosine LR scheduler  |  grad_clip = 1.0"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;"
