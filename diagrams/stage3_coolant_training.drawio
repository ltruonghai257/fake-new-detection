        </mxCell>

        <!-- 3 Modules row -->
        <mxCell id="10" value="&lt;b&gt;Similarity Module&lt;/b&gt;&#xa;Cosine sim: text ↔ image&#xa;text_aligned_sim [B, 64]&#xa;image_aligned_sim [B, 64]"
