          <mxGeometry x="460" y="440" width="260" height="95" as="geometry" />
        </mxCell>

        <mxCell id="12" value="&lt;b&gt;Detection Module&lt;/b&gt;&#xa;Fake news binary detection&#xa;detection_logits [B, 2]&#xa;attention + ambiguity weights"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="820" y="440" width="260" height="95" as="geometry" />
        </mxCell>

        <!-- ── LOSSES ROW ──────────────────────────────────────────────────── -->

        <!-- L_CL (§3.2.1) -->
        <mxCell id="13" value="&lt;b&gt;L_CL  (§3.2.1)&lt;/b&gt;&#xa;Cross-modal Consistency Learning&#xa;CosineEmbeddingLoss(margin=0.2)&#xa;matched +1  |  unmatched −1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="610" width="230" height="85" as="geometry" />
        </mxCell>

        <!-- L_Con (§3.2.2) -->
        <mxCell id="14" value="&lt;b&gt;L_Con  (§3.2.2)&lt;/b&gt;&#xa;Cross-modal Contrastive Learning&#xa;Bidirectional cross-entropy&#xa;img→txt + txt→img"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="610" width="230" height="85" as="geometry" />
        </mxCell>

        <!-- L_SM (§3.2.3-3.2.4) — paper-faithful, highlighted yellow -->
        <mxCell id="40" value="&lt;b&gt;⭐ L_SM  (§3.2.3–3.2.4)&lt;/b&gt;&#xa;Soft Semantic Matching&#xa;targets:  softmax(SimilarityModule logits) [no grad]&#xa;preds:    CLIP module logits"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="550" y="610" width="270" height="85" as="geometry" />
        </mxCell>

        <!-- L_D (§3.4) -->
        <mxCell id="15" value="&lt;b&gt;L_D  (§3.4)&lt;/b&gt;&#xa;= L_CLS + γ·L_AG  (γ=0.5)&#xa;L_CLS: CrossEntropy(logits, labels)&#xa;L_AG:  KLDiv(attention, ambiguity)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="840" y="610" width="240" height="85" as="geometry" />
        </mxCell>

        <!-- ── TASK COMBINED LOSSES ─────────────────────────────────────────── -->

        <!-- Task 1 combined -->
        <mxCell id="16" value="&lt;b&gt;Task 1  L_multi&lt;/b&gt;&#xa;= 0.5 × L_CL  +  0.2 × (L_Con + L_SM)&#xa;backward → optim_similarity + optim_clip"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="130" y="760" width="470" height="65" as="geometry" />
        </mxCell>

        <!-- Task 2 combined -->
        <mxCell id="41" value="&lt;b&gt;Task 2  L_D&lt;/b&gt;&#xa;= L_CLS + γ·L_AG  (γ=0.5)&#xa;backward → optim_detection"
