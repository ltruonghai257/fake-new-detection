        <!-- CLIP Module → L_soft (predictions) -->
        <mxCell id="40" value="predictions&#xa;clip_logits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="12" target="17">
