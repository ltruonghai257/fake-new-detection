        <mxCell id="37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;exitX=0.87;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="7" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SimilarityModule → L_cos (ta_m, ia_m) -->
        <mxCell id="38" value="ta_m, ia_m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="11" target="15">
