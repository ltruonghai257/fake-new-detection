        <!-- CLIP Module → L_clip (clip_ta_m, clip_ia_m) -->
        <mxCell id="39" value="clip_ta_m, clip_ia_m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;" edge="1" parent="1" source="12" target="16">
